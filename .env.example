# HPLink PBX Cloud - Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# Database Configuration
# ========================================
DATABASE_URL=postgresql://hplink:hplink@localhost/hplink_pbx

# ========================================
# API Server Configuration
# ========================================
API_HOST=0.0.0.0
API_PORT=8000

# JWT Secrets (CHANGE THESE!)
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# HMAC Authentication
HMAC_CLOCK_SKEW_SECONDS=300

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://admin.hplinkpbx.com,https://portal.hplinkpbx.com

# ========================================
# PBX Core Configuration
# ========================================
# Ports
PBX_UDP_PORT=5060
PBX_TCP_PORT=5061
PBX_TLS_PORT=5062
PBX_WSS_PORT=5063

# TLS Certificates
PBX_TLS_CERT_FILE=/etc/letsencrypt/live/pbx.hplinkpbx.com/fullchain.pem
PBX_TLS_KEY_FILE=/etc/letsencrypt/live/pbx.hplinkpbx.com/privkey.pem
PBX_TLS_CA_FILE=/etc/letsencrypt/live/pbx.hplinkpbx.com/chain.pem

# API Connection
PBX_API_URL=http://localhost:8000
PBX_API_USER=pbx-core
PBX_API_SECRET=change-this-pbx-core-secret

# Media and Storage
PBX_MEDIA_ROOT=/var/lib/hplink-pbx/media
PBX_RECORDINGS_ROOT=/var/lib/hplink-pbx/recordings

# RTP Engine (optional)
# PBX_RTP_ENGINE_URL=udp:127.0.0.1:2223

# Logging
PBX_LOG_LEVEL=INFO

# Security
PBX_MAX_CONCURRENT_CALLS_GLOBAL=500
PBX_AUTH_CACHE_TTL=300
PBX_RATE_LIMIT_PER_IP=10

# ========================================
# Storage Configuration
# ========================================
STORAGE_ROOT=/var/lib/hplink-pbx/storage
RECORDINGS_ROOT=/var/lib/hplink-pbx/recordings

# ========================================
# SMTP Configuration (Optional)
# ========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@hplinkpbx.com
SMTP_PASSWORD=smtp-password
SMTP_FROM=noreply@hplinkpbx.com

# ========================================
# Frontend Configuration
# ========================================
# Admin Portal
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3000

# Client Portal
NEXT_PUBLIC_CLIENT_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_WSS_URL=wss://pbx.hplinkpbx.com:5063

# ========================================
# WHMCS Configuration
# ========================================
WHMCS_API_USER=whmcs-integration
WHMCS_API_SECRET=change-this-whmcs-secret
